<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 (API 31) and above. Same include-list as backup_rules.xml, applied to
     both cloud backup and direct device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path=".config/Klippy/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path=".config/Klippy/" />
    </device-transfer>
</data-extraction-rules>
