<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Klippy.ViewModels"
             x:Class="Klippy.Views.EditorOverlay"
             x:DataType="vm:MainViewModel"
             SizeChanged="OverlaySizeChanged">

  <Panel IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
    <!-- The scrim dims and swallows clicks but does not close: a stray click beside
         the dialog must not throw away an edit. Cancel and Esc are the ways out. -->
    <Border Background="{StaticResource ScrimBrush}" />

    <!-- Width is a starting size, not a cap: the grip writes Width/Height and the
         code-behind keeps MaxWidth/MaxHeight at whatever the window allows. -->
    <Border x:Name="Dialog" Width="520" MinWidth="320" Margin="20"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
            CornerRadius="8" Padding="16">
      <Panel>
        <ContentControl Content="{Binding Editor}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:EditorViewModel">
              <!-- Grid, not StackPanel, so the content field is the one row that
                   takes up the height the grip adds. -->
              <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />

                <StackPanel Grid.Row="1" Spacing="4">
                  <TextBlock Classes="mono" Text="LABEL" FontSize="10" LetterSpacing="0.8"
                             Foreground="{StaticResource MutedBrush}" />
                  <TextBox Classes="field" Loaded="FirstFieldLoaded"
                           Watermark="e.g. Send log files"
                           Text="{Binding Label}" />
                </StackPanel>

                <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="4">
                  <TextBlock Grid.Row="0" Classes="mono" Text="CONTENT" FontSize="10" LetterSpacing="0.8"
                             Foreground="{StaticResource MutedBrush}" />
                  <TextBox Grid.Row="1" Classes="field mono" FontSize="11"
                           AcceptsReturn="True" TextWrapping="Wrap"
                           MinHeight="140"
                           Watermark="Text to copy to the clipboard"
                           Text="{Binding Content}" />
                </Grid>

                <Grid Grid.Row="3" ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto">
                  <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                    <TextBlock Classes="mono" Text="TAG" FontSize="10" LetterSpacing="0.8"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBox Classes="field mono" Watermark="e.g. work"
                             Text="{Binding Tag}" />
                  </StackPanel>
                  <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                    <TextBlock Classes="mono" Text="QUICK-CODE" FontSize="10" LetterSpacing="0.8"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBox Classes="field mono" Watermark="e.g. slf"
                             Text="{Binding QuickCode}" />
                  </StackPanel>

                  <!-- The tags already in use. Full width rather than under the TAG box alone,
                       so a handful of them fit on one line. The margin does the spacing that
                       the grid's would otherwise leave behind when there are no tags yet. -->
                  <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Spacing="4"
                              Margin="0,10,0,0" IsVisible="{Binding HasTagSuggestions}">
                    <TextBlock Classes="mono" Text="EXISTING TAGS" FontSize="10" LetterSpacing="0.8"
                               Foreground="{StaticResource MutedBrush}" />
                    <!-- Capped so a long list scrolls instead of pushing the dialog off screen. -->
                    <ScrollViewer MaxHeight="74"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding TagSuggestions}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel ItemSpacing="6" LineSpacing="6" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:TagChipViewModel">
                            <!-- Not a tab stop: the chips are a pointer shortcut for what the
                                 TAG box above already does, and tabbing through a dozen of
                                 them to reach QUICK-CODE would cost the keyboard more than
                                 they give it. -->
                            <Button Classes="chip" IsTabStop="False" Loaded="TagChipLoaded"
                                    Classes.selected="{Binding IsSelected}"
                                    Content="{Binding Name}"
                                    Command="{Binding $parent[ItemsControl].((vm:EditorViewModel)DataContext).SelectTagCommand}"
                                    CommandParameter="{Binding}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </StackPanel>
                </Grid>

                <StackPanel Grid.Row="4" Spacing="4">
                  <TextBlock Classes="mono" Text="FORMAT" FontSize="10" LetterSpacing="0.8"
                             Foreground="{StaticResource MutedBrush}" />
                  <!-- DockPanel, not a horizontal StackPanel: the note has to wrap into
                       what is left beside the chip rather than run off a phone screen. -->
                  <DockPanel>
                    <ToggleButton DockPanel.Dock="Left" Classes="chip" Content="Markdown"
                                  Margin="0,0,8,0" IsChecked="{Binding IsMarkdown}" />
                    <TextBlock FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"
                               Text="Copy keeps formatting when pasted into a rich-text editor" />
                  </DockPanel>
                </StackPanel>

                <StackPanel Grid.Row="5" Spacing="4">
                  <TextBlock Classes="mono" Text="WHEN TRIGGERED" FontSize="10" LetterSpacing="0.8"
                             Foreground="{StaticResource MutedBrush}" />
                  <DockPanel>
                    <ToggleButton DockPanel.Dock="Left" Classes="chip" Content="Execute"
                                  Margin="0,0,8,0" IsChecked="{Binding IsExecutable}" />
                    <!-- Two blocks rather than a converter: a marker put on something
                         that cannot run has to read as the warning it is. -->
                    <Panel>
                      <TextBlock FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"
                                 IsVisible="{Binding !ExecuteHintIsWarning}"
                                 Foreground="{StaticResource MutedBrush}"
                                 Text="{Binding ExecuteHint}" />
                      <TextBlock FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"
                                 IsVisible="{Binding ExecuteHintIsWarning}"
                                 Foreground="{StaticResource DangerBrush}"
                                 Text="{Binding ExecuteHint}" />
                    </Panel>
                  </DockPanel>
                </StackPanel>

                <!-- The keys that trigger it: a shortcut while Klippy is up (a chord allowed), and a hotkey
                     from anywhere where this head registers them. Fields you click and then press keys
                     into, rather than text boxes: Ctrl+K typed into a text box is just a K. -->
                <StackPanel Grid.Row="6" Spacing="4" IsVisible="{Binding ShowsShortcuts}">
                  <Grid ColumnDefinitions="*,12,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                      <TextBlock Classes="mono" Text="SHORTCUT IN KLIPPY" FontSize="10" LetterSpacing="0.8"
                                 Foreground="{StaticResource MutedBrush}" />
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Classes="icon ghost" Margin="4,0,0,0"
                                IsVisible="{Binding HasShortcut}" Command="{Binding ClearShortcutCommand}"
                                ToolTip.Tip="Remove the shortcut">
                          <Viewbox Width="10" Height="10">
                            <Grid Width="24" Height="24">
                              <Path Data="M 6,6 L 18,18 M 18,6 L 6,18" Stroke="{StaticResource Muted3Brush}"
                                    StrokeThickness="2.4" StrokeLineCap="Round" />
                            </Grid>
                          </Viewbox>
                        </Button>
                        <Button x:Name="ShortcutField" Classes="keyField"
                                Classes.recording="{Binding IsRecordingShortcut}"
                                Command="{Binding RecordShortcutCommand}"
                                ToolTip.Tip="Click, then press the keys — two in a row for a chord">
                          <Panel>
                            <TextBlock Text="{Binding ShortcutText}" />
                            <TextBlock Text="click, then press keys" Foreground="{StaticResource MutedBrush}"
                                       IsVisible="{Binding ShortcutText, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                          </Panel>
                        </Button>
                      </DockPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4" IsVisible="{Binding ShowsHotkey}">
                      <TextBlock Classes="mono" Text="HOTKEY ANYWHERE" FontSize="10" LetterSpacing="0.8"
                                 Foreground="{StaticResource MutedBrush}" />
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Classes="icon ghost" Margin="4,0,0,0"
                                IsVisible="{Binding HasHotkey}" Command="{Binding ClearHotkeyCommand}"
                                ToolTip.Tip="Remove the hotkey">
                          <Viewbox Width="10" Height="10">
                            <Grid Width="24" Height="24">
                              <Path Data="M 6,6 L 18,18 M 18,6 L 6,18" Stroke="{StaticResource Muted3Brush}"
                                    StrokeThickness="2.4" StrokeLineCap="Round" />
                            </Grid>
                          </Viewbox>
                        </Button>
                        <Button x:Name="HotkeyField" Classes="keyField"
                                Classes.recording="{Binding IsRecordingHotkey}"
                                Command="{Binding RecordHotkeyCommand}"
                                ToolTip.Tip="Click, then press the keys — works in any application">
                          <Panel>
                            <TextBlock Text="{Binding HotkeyText}" />
                            <TextBlock Text="click, then press keys" Foreground="{StaticResource MutedBrush}"
                                       IsVisible="{Binding HotkeyText, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                          </Panel>
                        </Button>
                      </DockPanel>
                    </StackPanel>
                  </Grid>
                  <!-- One line per field, said as the keys go in: what they'll do, whose they'll take, or
                       why they can't be had. A refusal reads as the warning it is. -->
                  <Panel>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                               IsVisible="{Binding !ShortcutHintIsWarning}" Text="{Binding ShortcutHint}" />
                    <TextBlock x:Name="ShortcutWarning" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource DangerBrush}"
                               IsVisible="{Binding ShortcutHintIsWarning}" Text="{Binding ShortcutHint}" />
                  </Panel>
                  <Panel IsVisible="{Binding ShowsHotkey}">
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                               IsVisible="{Binding !HotkeyHintIsWarning}" Text="{Binding HotkeyHint}" />
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"
                               IsVisible="{Binding HotkeyHintIsWarning}" Text="{Binding HotkeyHint}" />
                  </Panel>
                </StackPanel>

                <DockPanel Grid.Row="7" Margin="0,4,0,0">
                  <Button DockPanel.Dock="Left" Classes="subtle" Content="Duplicate"
                          IsVisible="{Binding HasDuplicate}"
                          Command="{Binding DuplicateCommand}" />
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Classes="subtle" Content="Cancel" Command="{Binding CancelCommand}" />
                    <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}" />
                  </StackPanel>
                </DockPanel>
              </Grid>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- Resize grip. The negative margin lifts it out of the content box and into
             the border padding, so it sits in the corner clear of the Save button. -->
        <Thumb x:Name="ResizeGrip" Classes="resizeGrip"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Margin="0,0,-14,-14" DragDelta="ResizeDelta" />
      </Panel>
    </Border>
  </Panel>
</UserControl>
