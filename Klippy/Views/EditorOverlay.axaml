<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Klippy.ViewModels"
             x:Class="Klippy.Views.EditorOverlay"
             x:DataType="vm:MainViewModel"
             SizeChanged="OverlaySizeChanged">

  <Panel IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
    <!-- The scrim dims and swallows clicks but does not close: a stray click beside
         the dialog must not throw away an edit. Cancel and Esc are the ways out. -->
    <Border Background="{StaticResource ScrimBrush}" />

    <!-- Width is a starting size, not a cap: the grip writes Width/Height and the
         code-behind keeps MaxWidth/MaxHeight at whatever the window allows. -->
    <Border x:Name="Dialog" Width="520" MinWidth="320" Margin="20"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
            CornerRadius="8" Padding="16">
      <Panel>
        <ContentControl Content="{Binding Editor}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:EditorViewModel">
              <!-- Grid, not StackPanel, so the content field is the one row that
                   takes up the height the grip adds. -->
              <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" RowSpacing="10">
                <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />

                <StackPanel Grid.Row="1" Spacing="4">
                  <TextBlock Classes="mono" Text="LABEL" FontSize="10" LetterSpacing="0.8"
                             Foreground="{StaticResource MutedBrush}" />
                  <TextBox Classes="field" Loaded="FirstFieldLoaded"
                           Watermark="e.g. Send log files"
                           Text="{Binding Label}" />
                </StackPanel>

                <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="4">
                  <TextBlock Grid.Row="0" Classes="mono" Text="CONTENT" FontSize="10" LetterSpacing="0.8"
                             Foreground="{StaticResource MutedBrush}" />
                  <TextBox Grid.Row="1" Classes="field mono" FontSize="11"
                           AcceptsReturn="True" TextWrapping="Wrap"
                           MinHeight="140"
                           Watermark="Text to copy to the clipboard"
                           Text="{Binding Content}" />
                </Grid>

                <Grid Grid.Row="3" ColumnDefinitions="*,12,*">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Classes="mono" Text="TAG" FontSize="10" LetterSpacing="0.8"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBox Classes="field mono" Watermark="e.g. work"
                             Text="{Binding Tag}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Classes="mono" Text="QUICK-CODE" FontSize="10" LetterSpacing="0.8"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBox Classes="field mono" Watermark="e.g. slf"
                             Text="{Binding QuickCode}" />
                  </StackPanel>
                </Grid>

                <StackPanel Grid.Row="4" Spacing="4">
                  <TextBlock Classes="mono" Text="FORMAT" FontSize="10" LetterSpacing="0.8"
                             Foreground="{StaticResource MutedBrush}" />
                  <!-- DockPanel, not a horizontal StackPanel: the note has to wrap into
                       what is left beside the chip rather than run off a phone screen. -->
                  <DockPanel>
                    <ToggleButton DockPanel.Dock="Left" Classes="chip" Content="Markdown"
                                  Margin="0,0,8,0" IsChecked="{Binding IsMarkdown}" />
                    <TextBlock FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"
                               Text="Copy keeps formatting when pasted into a rich-text editor" />
                  </DockPanel>
                </StackPanel>

                <StackPanel Grid.Row="5" Spacing="4">
                  <TextBlock Classes="mono" Text="WHEN TRIGGERED" FontSize="10" LetterSpacing="0.8"
                             Foreground="{StaticResource MutedBrush}" />
                  <DockPanel>
                    <ToggleButton DockPanel.Dock="Left" Classes="chip" Content="Execute"
                                  Margin="0,0,8,0" IsChecked="{Binding IsExecutable}" />
                    <!-- Two blocks rather than a converter: a marker put on something
                         that cannot run has to read as the warning it is. -->
                    <Panel>
                      <TextBlock FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"
                                 IsVisible="{Binding !ExecuteHintIsWarning}"
                                 Foreground="{StaticResource MutedBrush}"
                                 Text="{Binding ExecuteHint}" />
                      <TextBlock FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"
                                 IsVisible="{Binding ExecuteHintIsWarning}"
                                 Foreground="{StaticResource DangerBrush}"
                                 Text="{Binding ExecuteHint}" />
                    </Panel>
                  </DockPanel>
                </StackPanel>

                <DockPanel Grid.Row="6" Margin="0,4,0,0">
                  <Button DockPanel.Dock="Left" Classes="subtle" Content="Duplicate"
                          IsVisible="{Binding HasDuplicate}"
                          Command="{Binding DuplicateCommand}" />
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Classes="subtle" Content="Cancel" Command="{Binding CancelCommand}" />
                    <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}" />
                  </StackPanel>
                </DockPanel>
              </Grid>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- Resize grip. The negative margin lifts it out of the content box and into
             the border padding, so it sits in the corner clear of the Save button. -->
        <Thumb x:Name="ResizeGrip" Classes="resizeGrip"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Margin="0,0,-14,-14" DragDelta="ResizeDelta" />
      </Panel>
    </Border>
  </Panel>
</UserControl>
