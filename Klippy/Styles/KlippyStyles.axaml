<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============ Text ============ -->
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
  </Style>

  <!-- ============ Chromeless TextBox (search field, inside its own border) ============ -->
  <Style Selector="TextBox.bare">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="SelectionBrush" Value="{StaticResource SelectionBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
  </Style>
  <Style Selector="TextBox.bare /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
  <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- ============ Editor input fields ============ -->
  <Style Selector="TextBox.field">
    <Setter Property="Background" Value="{StaticResource AppBgBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="9,7" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="SelectionBrush" Value="{StaticResource SelectionBrush}" />
  </Style>
  <Style Selector="TextBox.field /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
  <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource AppBgBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
  </Style>
  <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource AppBgBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="TextBox.field.mono">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
  </Style>

  <!-- ============ Accent button ("+ New", Save) ============ -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource IconHoverBrush}" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>

  <!-- ============ Subtle button (Cancel) ============ -->
  <Style Selector="Button.subtle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Muted3Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource IconHoverBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <!-- ============ Danger button (Delete confirm) ============ -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource DangerHoverBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- ============ Icon buttons (24px desktop row actions) ============ -->
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{StaticResource IconHoverBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BorderStrongBrush}" />
  </Style>
  <Style Selector="Button.icon.amber">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="Button.icon.amber:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
  </Style>
  <!-- invisible until hover/expand: chevron toggle -->
  <Style Selector="Button.icon.ghost">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- ============ Tag chips ============ -->
  <Style Selector="Button.chip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Muted3Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
  </Style>
  <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverRowBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.chip.selected">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.chip.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
  </Style>
  <!-- The History chip switches what the list shows rather than filtering it, so it is
       set apart: a heavier border and a gap before the tags that follow it. -->
  <Style Selector="Button.chip.mode">
    <Setter Property="BorderBrush" Value="{StaticResource Muted2Brush}" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <!-- mobile chips are a size up -->
  <Style Selector="Button.chip.mobileChip">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="12,5" />
  </Style>

  <!-- ============ Chip-style toggle (Markdown switch in the editor) ============ -->
  <Style Selector="ToggleButton.chip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Muted3Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
  </Style>
  <Style Selector="ToggleButton.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverRowBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="ToggleButton.chip:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
  </Style>

  <!-- ============ Footer text link (export / import) ============ -->
  <Style Selector="Button.footerLink">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.footerLink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <!-- .on marks a link whose pane is currently showing -->
  <Style Selector="Button.footerLink.on">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>

  <!-- ============ Editor dialog resize grip ============ -->
  <!-- A Thumb for the drag plumbing (capture, :pressed), templated down to a corner
       hatch so it reads as a grip rather than a button. -->
  <Style Selector="Thumb.resizeGrip">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="BottomRightCorner" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="{TemplateBinding Background}">
          <Viewbox Width="12" Height="12">
            <Grid Width="24" Height="24">
              <Path Classes="grip" Data="{StaticResource IconResizeGrip}"
                    Stroke="{StaticResource BorderStrongBrush}" StrokeThickness="2"
                    StrokeLineCap="Round" />
            </Grid>
          </Viewbox>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Thumb.resizeGrip:pointerover /template/ Path.grip">
    <Setter Property="Stroke" Value="{StaticResource Muted3Brush}" />
  </Style>
  <Style Selector="Thumb.resizeGrip:pressed /template/ Path.grip">
    <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
  </Style>

  <!-- ============ Preview pane ============ -->
  <!-- Splitter doubles as the separator above the pane, so the header only draws
       its lower hairline. -->
  <Style Selector="GridSplitter.previewSplitter">
    <Setter Property="Height" Value="7" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{StaticResource AppBgBrush}" />
    <Setter Property="Cursor" Value="SizeNorthSouth" />
    <!-- templated so the bar can carry a centre grip: a bare 7px band reads as one
         more hairline and gives no hint that it is draggable -->
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1">
          <Rectangle Classes="grip" Width="28" Height="2" RadiusX="1" RadiusY="1"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Fill="{StaticResource BorderStrongBrush}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="GridSplitter.previewSplitter:pointerover /template/ Rectangle.grip">
    <Setter Property="Fill" Value="{StaticResource Muted3Brush}" />
  </Style>
  <Style Selector="GridSplitter.previewSplitter:pressed /template/ Rectangle.grip">
    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
  </Style>

  <Style Selector="Button.previewHeader">
    <Setter Property="Background" Value="{StaticResource AppBgBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.previewHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverRowBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
  </Style>
  <Style Selector="Button.previewHeader:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SelectedRowBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
  </Style>

  <!-- ============ Snippet list ============ -->
  <!-- The unmatched-search offer. Not a list row, but it stands where the first one would
       and can hold the selection instead of one, so it answers "what is Enter about to do"
       exactly as a row does: an accent bar, an accent label, and the ↵ badge — none of
       which it shows while a row has the selection instead. -->
  <Style Selector="Button.offerRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="12,9,14,9" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.offer Rectangle.selBar">
    <Setter Property="Fill" Value="Transparent" />
  </Style>
  <Style Selector="Border.offer Border.enterBadge">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.offer TextBlock.offerVerb">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Border.offer TextBlock.offerDetail">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.offerRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverRowBrush}" />
  </Style>

  <!-- after the hover rule, so holding the selection wins over the pointer being near -->
  <Style Selector="Border.offer.selected Button.offerRow /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SelectedRowBrush}" />
  </Style>
  <Style Selector="Border.offer.selected Rectangle.selBar">
    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="Border.offer.selected Border.enterBadge">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Border.offer.selected TextBlock.offerVerb">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="Border.offer.selected TextBlock.offerDetail">
    <Setter Property="Foreground" Value="{StaticResource TextSelPreviewBrush}" />
  </Style>

  <Style Selector="ListBox.snips">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.snips ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <!-- kill Fluent's default selection/hover chrome -->
  <Style Selector="ListBox.snips ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.snips ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.snips ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- desktop row: base values live here (not inline) so state styles below can override -->
  <Style Selector="ListBox.desktop Border.rowSurface">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.desktop Rectangle.selBar">
    <Setter Property="Fill" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.desktop TextBlock.rowLabel">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="ListBox.desktop TextBlock.rowPreview">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="ListBox.desktop Border.enterBadge">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ListBox.desktop StackPanel.hoverActions">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- desktop row states -->
  <Style Selector="ListBox.desktop ListBoxItem:pointerover Border.rowSurface">
    <Setter Property="Background" Value="{StaticResource HoverRowBrush}" />
  </Style>
  <Style Selector="ListBox.desktop ListBoxItem:selected Border.rowSurface">
    <Setter Property="Background" Value="{StaticResource SelectedRowBrush}" />
  </Style>
  <Style Selector="ListBox.desktop ListBoxItem:selected Rectangle.selBar">
    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="ListBox.desktop ListBoxItem:selected TextBlock.rowLabel">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="ListBox.desktop ListBoxItem:selected TextBlock.rowPreview">
    <Setter Property="Foreground" Value="{StaticResource TextSelPreviewBrush}" />
  </Style>
  <Style Selector="ListBox.desktop ListBoxItem:selected Border.enterBadge">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="ListBox.desktop ListBoxItem:selected Path.copyGlyph">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ListBox.desktop ListBoxItem:pointerover StackPanel.trailing">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ListBox.desktop ListBoxItem:pointerover StackPanel.hoverActions">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <!-- ============ Toast ============ -->
  <Style Selector="Border.toast">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Background" Value="{StaticResource SelectedRowBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.toast.visible">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- ============ Recent commands (MRU) ============ -->
  <Style Selector="ListBox.commands">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0,2" />
  </Style>
  <Style Selector="ListBox.commands ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Muted3Brush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ListBox.commands ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.commands ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverRowBrush}" />
  </Style>
  <!-- The browsed line is also in the search box, so it is marked the way a selected row
       is: accent text on the selected-row fill, not Fluent's blue block. -->
  <Style Selector="ListBox.commands ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SelectedRowBrush}" />
  </Style>
  <Style Selector="ListBox.commands ListBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>

  <!-- ============ Scrollbars: slim, unobtrusive ============ -->
  <Style Selector="ListBox.snips ScrollBar:vertical">
    <Setter Property="AllowAutoHide" Value="True" />
  </Style>
  <Style Selector="ListBox.commands ScrollBar:vertical">
    <Setter Property="AllowAutoHide" Value="True" />
  </Style>
</Styles>
