<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 2px-stroke line glyphs on a 24x24 grid, from the design's inline SVGs.
       Render with Path Stroke=... inside a sized Viewbox so stroke width scales like SVG. -->
  <StreamGeometry x:Key="IconSearch">M 18,11 A 7,7 0 1 0 4,11 A 7,7 0 1 0 18,11 M 21,21 L 16.5,16.5</StreamGeometry>
  <StreamGeometry x:Key="IconCopy">M 11,9 L 18,9 A 2,2 0 0 1 20,11 L 20,18 A 2,2 0 0 1 18,20 L 11,20 A 2,2 0 0 1 9,18 L 9,11 A 2,2 0 0 1 11,9 Z M 5,15 L 5,5 A 2,2 0 0 1 7,3 L 17,3</StreamGeometry>
  <StreamGeometry x:Key="IconPencil">M 17,3 A 2.8,2.8 0 1 1 21,7 L 7.5,20.5 L 2,22 L 3.5,16.5 Z</StreamGeometry>
  <StreamGeometry x:Key="IconTrash">M 3,6 L 21,6 M 8,6 L 8,4 A 1,1 0 0 1 9,3 L 15,3 A 1,1 0 0 1 16,4 L 16,6 M 19,6 L 19,20 A 2,2 0 0 1 17,22 L 7,22 A 2,2 0 0 1 5,20 L 5,6</StreamGeometry>
  <StreamGeometry x:Key="IconCheck">M 20,6 L 9,17 L 4,12</StreamGeometry>
  <StreamGeometry x:Key="IconChevronUp">M 6,15 L 12,9 L 18,15</StreamGeometry>
  <StreamGeometry x:Key="IconChevronDown">M 6,9 L 12,15 L 18,9</StreamGeometry>
  <StreamGeometry x:Key="IconPlus">M 12,5 L 12,19 M 5,12 L 19,12</StreamGeometry>
  <StreamGeometry x:Key="IconTransfer">M 8,20 L 8,4 M 4,8 L 8,4 L 12,8 M 16,4 L 16,20 M 12,16 L 16,20 L 20,16</StreamGeometry>
  <!-- corner hatch for the editor dialog's resize grip -->
  <StreamGeometry x:Key="IconResizeGrip">M 21,10 L 10,21 M 21,16 L 16,21</StreamGeometry>
  <!-- stacked sheets, for a clip that holds a file selection -->
  <StreamGeometry x:Key="IconFiles">M 8,3 L 15,3 L 20,8 L 20,17 A 2,2 0 0 1 18,19 L 8,19 A 2,2 0 0 1 6,17 L 6,5 A 2,2 0 0 1 8,3 Z M 15,3 L 15,8 L 20,8 M 3,8 L 3,20 A 2,2 0 0 0 5,22 L 16,22</StreamGeometry>
  <!-- pushpin, for keeping a clip out of the history's eviction -->
  <StreamGeometry x:Key="IconPin">M 9,4 L 15,4 M 10,4 L 10,10 L 6.5,14 L 17.5,14 L 14,10 L 14,4 M 12,14 L 12,21</StreamGeometry>
  <!-- bookmark: promote a clip into a saved snippet -->
  <StreamGeometry x:Key="IconBookmark">M 6,3 L 18,3 A 1,1 0 0 1 19,4 L 19,21 L 12,16 L 5,21 L 5,4 A 1,1 0 0 1 6,3 Z</StreamGeometry>
  <!-- copy glyph with a plus in the front sheet (duplicate) -->
  <StreamGeometry x:Key="IconDuplicate">M 11,9 L 18,9 A 2,2 0 0 1 20,11 L 20,18 A 2,2 0 0 1 18,20 L 11,20 A 2,2 0 0 1 9,18 L 9,11 A 2,2 0 0 1 11,9 Z M 5,15 L 5,5 A 2,2 0 0 1 7,3 L 17,3 M 14.5,11.5 L 14.5,17.5 M 11.5,14.5 L 17.5,14.5</StreamGeometry>
</ResourceDictionary>
