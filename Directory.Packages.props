<Project>
    <!-- https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <!-- Avalonia packages -->
        <!-- Important: keep version in sync! -->
        <PackageVersion Include="Avalonia" Version="12.1.6" />
        <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.6" />
        <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.6" />
        <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
        <PackageVersion Include="Avalonia.iOS" Version="12.1.6" />
        <PackageVersion Include="Avalonia.Browser" Version="12.1.6" />
        <PackageVersion Include="Avalonia.Android" Version="12.1.6" />

        <PackageVersion Include="Avalonia.Skia" Version="12.1.6" />
        <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.6" />

        <PackageVersion Include="FSharp.Core" Version="11.0.101" />

        <PackageVersion Include="Markdig" Version="1.6.0" />

        <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />

        <!-- Held at 1.2.0.2, which sits on AppCompat 1.7.1.3 like Avalonia.Android 12.1.6 does.
             1.2.0.3 pulls AndroidX.Core 1.19 and with it Lifecycle 2.11, which the Lifecycle
             2.10 packages under Avalonia.Android pin against (NU1608). Move both together. -->
        <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.2.0.2" />

        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
        <!-- xunit v3, because Avalonia.Headless.XUnit 12 is built on it. Held at 3.2.2, the
             version Avalonia.Headless.XUnit compiles against: xunit v3 4.x changed the
             extensibility API it calls, and every [AvaloniaFact] then fails discovery with a
             MissingMethodException. Move it when Avalonia ships a build against 4.x. -->
        <PackageVersion Include="xunit.v3" Version="3.2.2" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    </ItemGroup>
</Project>