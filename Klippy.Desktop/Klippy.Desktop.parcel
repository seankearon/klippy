{
    "GeneralSettings": {
        "NetProjectPath": "Klippy.Desktop.csproj",
        "PackageName": "Klippy",
        "AssemblyName": {
            "$type": "msbuild",
            "property": "AssemblyName"
        },
        "ApplicationName": "Klippy",
        "Version": {
            "$type": "msbuild",
            "property": "Version"
        },
        "Icon": "../Klippy/Assets/klippy.ico",
        "Company": "Atlantic Business Solutions Ltd"
    },
    "LinuxSettings": {
        "CreateBinSymlink": "True"
    },
    "Win32Settings": {
        "IncludeUninstaller": "True"
    },
    "MacOsSettings": {
        "CreateBundle": true,
        "BundleIdentifier": "com.seankearon.klippy",
        "SigningCredentialsType": "AdHoc",
        "SignDeep": true
    },
    "PublishSettings": {
        "PublishSingleFile": "True",
        "ExtraBuildProperties": {
            "DebugType": "none"
        }
    }
}
