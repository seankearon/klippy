<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--If you are willing to use platform-specific APIs, use conditional compilation.
    See https://docs.avaloniaui.net/docs/guides/platforms/platform-specific-code/dotnet for more details.-->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Embeds a Win32 icon resource in the exe. The window and tray icons are loaded at
         runtime from the same .ico as an Avalonia asset, so the app looks right once it is
         up - but the Start menu entry, the pinned/shortcut taskbar button and Explorer all
         read the icon off the binary, and without this they fall back to the blank default
         placeholder. That is what an installed copy shows. -->
    <ApplicationIcon>..\Klippy\Assets\klippy.ico</ApplicationIcon>

    <!-- The assembly is Klippy.Desktop, since Klippy.dll is the shared library's. These
         are what Windows shows instead - Task Manager and the notification-area settings
         read the title as the exe's description - so they say Klippy, not the project. -->
    <AssemblyTitle>Klippy</AssemblyTitle>
    <Product>Klippy</Product>
  </PropertyGroup>

  <!-- Native AOT publish: fast cold start, small self-contained binary.
       Publish with: dotnet publish -c Release -r win-x64 (or osx-arm64/osx-x64 on a Mac). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>

    <!-- NativeAOT emits native code for the target, and ILC refuses to do that across
         operating systems: publishing osx-* from Windows fails with "Cross-OS native
         compilation is not supported". So for the mac runtimes, AOT is on exactly when
         the build is happening on a Mac. -->
    <PublishAot Condition="'$(RuntimeIdentifier)' == 'osx-arm64' Or '$(RuntimeIdentifier)' == 'osx-x64'">$([MSBuild]::IsOSPlatform(OSX))</PublishAot>

    <!-- The fallback for anything cross-built: trimmed and self-contained. Larger than a
         native binary and JIT-started rather than instant, but it runs, which is more
         than can be said for one that cannot be compiled. -->
    <PublishTrimmed Condition="'$(PublishAot)' != 'true'">true</PublishTrimmed>
    <SelfContained Condition="'$(PublishAot)' != 'true'">true</SelfContained>

    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <TrimMode>full</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics" >
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Klippy\Klippy.csproj" />
  </ItemGroup>
</Project>
