<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="BuildLib.fs" />
        <Compile Include="Program.fs" />
        <!-- The version the next build increments from; linked so it stays visible here. -->
        <Content Include="..\ver.txt" Link="ver.txt" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
    </ItemGroup>

</Project>
